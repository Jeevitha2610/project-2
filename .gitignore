*.py[cod]
*$py.class
*.so
*.pyc

# Virtual Environments
.venv/
venv/
env/
ENV/

# Node & Frontend
node_modules/
frontend/dist/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
